target 'MomorsApp' do
  pod 'ffmpeg-kit-react-native', :path => '../node_modules/ffmpeg-kit-react-native' # 或者你的 fork 路径
  pod 'Ads-CN-Beta','7.1.0.6', :subspecs => ['BUAdSDK', 'BUAdTestMeasurement']
  use_react_native!(
